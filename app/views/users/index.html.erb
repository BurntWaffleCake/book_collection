<p style="color: green"><%= notice %></p>

<% content_for :title, "Users" %>

<h1>Users</h1>

<div id="users" style="display: flex; flex-direction: column; gap: 1rem; margin-bottom: 1rem; width: fit-content;">
  <% @users.each do |user| %>
    <%= render user %>
  <% end %>
</div>

<div>
  <%= link_to "New user", new_user_path %> |
  <%= link_to "Back to User Books", root_path %>
</div>
